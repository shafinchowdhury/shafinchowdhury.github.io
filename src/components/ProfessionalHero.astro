---
interface Props {
  imageUrl?: string;
  imageAlt?: string;
}

const { imageUrl, imageAlt = "Md. Shafin Mahmud Chowdhury" } = Astro.props;
---

<section
  id="hero-editorial"
  class="border-border border-b bg-white py-12 sm:py-16 lg:py-20 dark:border-zinc-800 dark:bg-transparent"
>
  <div class="app-layout">
    <div class="grid gap-12 lg:grid-cols-2 lg:items-center lg:gap-16">
      <!-- Left: Headshot with fade-up and background blend -->
      {
        imageUrl && (
          <div class="hero-image-wrapper flex justify-center lg:justify-start">
            <div class="hero-image-container group relative">
              <img
                src={imageUrl}
                alt={imageAlt}
                class="hero-image h-72 w-72 rounded-2xl object-cover object-top transition-transform duration-500 ease-out group-hover:scale-[1.02] sm:h-80 sm:w-80 lg:h-96 lg:w-96"
              />
            </div>
          </div>
        )
      }

      <!-- Right: Content -->
      <div class="flex flex-col justify-center space-y-8">
        <!-- Headline & Author Badge -->
        <div class="space-y-3">
          <div class="inline-flex items-center gap-2">
            <span
              class="bg-accent/10 text-accent rounded-md px-2.5 py-1 text-xs font-semibold tracking-wider uppercase"
            >
              Developer & CS Student
            </span>
            <span class="text-muted-foreground text-xs">Shafin Chowdhury</span>
          </div>
          <h1
            class="text-3xl leading-tight font-bold tracking-tight text-slate-900 sm:text-4xl lg:text-5xl dark:text-white"
          >
            Programming & Computer Science, Explained Clearly
          </h1>
        </div>

        <!-- Mission / Supporting Statement -->
        <div>
          <p class="text-muted-foreground text-base leading-relaxed sm:text-lg">
            Practical programming guides, architecture deep dives, algorithms,
            mathematics, and software development notes by Shafin Chowdhury.
          </p>
        </div>

        <!-- CTA Buttons -->
        <div class="flex flex-wrap gap-3 sm:flex-row">
          <a
            href="/posts"
            class="cta-button primary-button bg-accent text-accent-foreground focus:outline-accent inline-flex items-center justify-center rounded-lg px-5 py-2.5 text-sm font-medium shadow-sm transition-all duration-300 hover:opacity-90 hover:shadow-md focus:outline-2 focus:outline-offset-2 sm:text-base"
          >
            Explore Articles
            <svg
              class="arrow-icon ml-2 h-4 w-4"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
            </svg>
          </a>
          <a
            href="/topics"
            class="cta-button secondary-button border-border hover:bg-muted focus:outline-accent inline-flex items-center justify-center rounded-lg border bg-white px-5 py-2.5 text-sm font-medium text-slate-900 shadow-sm transition-all duration-300 focus:outline-2 focus:outline-offset-2 sm:text-base dark:border-zinc-700 dark:bg-transparent dark:text-slate-100 dark:hover:bg-zinc-900/50"
          >
            Browse Topics
          </a>
          <a
            href="/about"
            class="cta-button secondary-button hover:border-border inline-flex items-center justify-center rounded-lg border border-transparent bg-transparent px-4 py-2.5 text-sm font-medium text-slate-700 transition-colors sm:text-base dark:text-slate-300 dark:hover:border-zinc-800"
          >
            About Me
          </a>
        </div>

        <!-- Social Links Indicator -->
        <div class="text-muted-foreground flex items-center gap-2 text-sm">
          <span>Connect:</span>
          <slot name="socials" />
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  #hero-editorial {
    animation: fadeIn 0.6s ease-out;
  }

  /* Hero Image Fadeup & Background Blending */
  .hero-image-wrapper {
    animation: heroFadeUp 0.85s cubic-bezier(0.16, 1, 0.3, 1) backwards;
  }

  .hero-image {
    -webkit-mask-image:
      linear-gradient(
        to right,
        rgba(0, 0, 0, 0) 0%,
        rgba(0, 0, 0, 0.05) 0.6%,
        rgba(0, 0, 0, 0.2) 1.5%,
        rgba(0, 0, 0, 0.48) 2.6%,
        rgba(0, 0, 0, 0.78) 3.8%,
        rgba(0, 0, 0, 0.94) 4.8%,
        rgba(0, 0, 0, 1) 5.8%,
        rgba(0, 0, 0, 1) 94.2%,
        rgba(0, 0, 0, 0.94) 95.2%,
        rgba(0, 0, 0, 0.78) 96.2%,
        rgba(0, 0, 0, 0.48) 97.4%,
        rgba(0, 0, 0, 0.2) 98.5%,
        rgba(0, 0, 0, 0.05) 99.4%,
        rgba(0, 0, 0, 0) 100%
      ),
      linear-gradient(
        to bottom,
        rgba(0, 0, 0, 0) 0%,
        rgba(0, 0, 0, 0.05) 0.6%,
        rgba(0, 0, 0, 0.2) 1.5%,
        rgba(0, 0, 0, 0.48) 2.6%,
        rgba(0, 0, 0, 0.78) 3.8%,
        rgba(0, 0, 0, 0.94) 4.8%,
        rgba(0, 0, 0, 1) 5.8%,
        rgba(0, 0, 0, 1) 93.2%,
        rgba(0, 0, 0, 0.94) 94.4%,
        rgba(0, 0, 0, 0.78) 95.8%,
        rgba(0, 0, 0, 0.48) 97.2%,
        rgba(0, 0, 0, 0.2) 98.5%,
        rgba(0, 0, 0, 0.05) 99.4%,
        rgba(0, 0, 0, 0) 100%
      );
    -webkit-mask-composite: source-in;
    mask-image:
      linear-gradient(
        to right,
        rgba(0, 0, 0, 0) 0%,
        rgba(0, 0, 0, 0.05) 0.6%,
        rgba(0, 0, 0, 0.2) 1.5%,
        rgba(0, 0, 0, 0.48) 2.6%,
        rgba(0, 0, 0, 0.78) 3.8%,
        rgba(0, 0, 0, 0.94) 4.8%,
        rgba(0, 0, 0, 1) 5.8%,
        rgba(0, 0, 0, 1) 94.2%,
        rgba(0, 0, 0, 0.94) 95.2%,
        rgba(0, 0, 0, 0.78) 96.2%,
        rgba(0, 0, 0, 0.48) 97.4%,
        rgba(0, 0, 0, 0.2) 98.5%,
        rgba(0, 0, 0, 0.05) 99.4%,
        rgba(0, 0, 0, 0) 100%
      ),
      linear-gradient(
        to bottom,
        rgba(0, 0, 0, 0) 0%,
        rgba(0, 0, 0, 0.05) 0.6%,
        rgba(0, 0, 0, 0.2) 1.5%,
        rgba(0, 0, 0, 0.48) 2.6%,
        rgba(0, 0, 0, 0.78) 3.8%,
        rgba(0, 0, 0, 0.94) 4.8%,
        rgba(0, 0, 0, 1) 5.8%,
        rgba(0, 0, 0, 1) 93.2%,
        rgba(0, 0, 0, 0.94) 94.4%,
        rgba(0, 0, 0, 0.78) 95.8%,
        rgba(0, 0, 0, 0.48) 97.2%,
        rgba(0, 0, 0, 0.2) 98.5%,
        rgba(0, 0, 0, 0.05) 99.4%,
        rgba(0, 0, 0, 0) 100%
      );
    mask-composite: intersect;
  }

  @keyframes heroFadeUp {
    from {
      opacity: 0;
      transform: translateY(28px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  /* CTA Button Animations */
  .cta-button {
    animation: slideUpIn 0.7s ease-out backwards;
  }

  .primary-button {
    animation-delay: 0.2s;
  }

  .secondary-button {
    animation-delay: 0.35s;
  }

  @keyframes slideUpIn {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .cta-button:hover {
    animation: liftUp 0.3s ease-out forwards;
  }

  @keyframes liftUp {
    to {
      transform: translateY(-4px);
    }
  }

  .arrow-icon {
    animation: arrowSlide 0.4s ease-out backwards;
  }

  .primary-button:hover .arrow-icon {
    animation: arrowSlideIn 0.4s ease-out forwards;
  }

  @keyframes arrowSlide {
    from {
      transform: translateX(-4px);
      opacity: 0;
    }
    to {
      transform: translateX(0);
      opacity: 1;
    }
  }

  @keyframes arrowSlideIn {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(4px);
    }
  }
</style>
