---
interface Props {
  title: string;
  description?: string;
  date: string;
  tags?: string[];
  href?: string;
}

const { title, description, date, tags = [], href = "#" } = Astro.props;

// Format date
const formattedDate = new Date(date).toLocaleDateString("en-US", {
  year: "numeric",
  month: "short",
  day: "numeric",
});
---

<a
  href={href}
  class="group border-border hover:border-accent block rounded-lg border bg-white p-6 transition-all duration-200 hover:shadow-md sm:p-8 dark:border-zinc-700 dark:bg-transparent"
>
  <div class="flex flex-col space-y-4">
    <!-- Header with date -->
    <div class="flex items-start justify-between gap-4">
      <div class="flex-1">
        <h3
          class="group-hover:text-accent text-xl font-semibold text-slate-900 transition-colors dark:text-white"
        >
          {title}
        </h3>
      </div>
      <time
        class="text-sm font-medium whitespace-nowrap text-slate-600 dark:text-slate-400"
      >
        {formattedDate}
      </time>
    </div>

    <!-- Description -->
    {
      description && (
        <p class="text-base leading-relaxed text-slate-600 dark:text-slate-300">
          {description}
        </p>
      )
    }

    <!-- Tags -->
    {
      tags && tags.length > 0 && (
        <div class="flex flex-wrap gap-2 pt-2">
          {tags.map(tag => (
            <span class="inline-flex items-center rounded-full bg-slate-100 px-3 py-1 text-xs font-medium text-slate-700 dark:bg-zinc-900/60 dark:text-slate-300">
              {tag}
            </span>
          ))}
        </div>
      )
    }

    <!-- Read More indicator -->
    <div
      class="text-accent text-sm font-medium transition-transform group-hover:translate-x-1"
    >
      Read more →
    </div>
  </div>
</a>

<style>
  a {
    transition: all 0.2s ease;
  }
</style>
