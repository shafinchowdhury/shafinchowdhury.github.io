---
/**
 * Google Analytics 4 (gtag.js).
 *
 * - Renders nothing unless PUBLIC_GA_MEASUREMENT_ID is set AND this is a
 *   production build, so dev/preview traffic never pollutes analytics.
 * - The site uses Astro's <ClientRouter /> (SPA-style navigation), so the
 *   automatic page_view is disabled and one is sent manually on every
 *   `astro:page-load` (fires on the initial load and after each navigation).
 * - gtag.js is loaded async so it never blocks rendering.
 */
import { PUBLIC_GA_MEASUREMENT_ID } from "astro:env/client";

const measurementId = import.meta.env.PROD
  ? PUBLIC_GA_MEASUREMENT_ID
  : undefined;
---

{
  measurementId && (
    <>
      <link rel="preconnect" href="https://www.googletagmanager.com" />
      <script
        is:inline
        async
        src={`https://www.googletagmanager.com/gtag/js?id=${measurementId}`}
      />
    </>
  )
}

<script is:inline define:vars={{ measurementId }}>
  if (measurementId && !window.__gaInitialized) {
    window.__gaInitialized = true;
    window.dataLayer = window.dataLayer || [];
    window.gtag = function () {
      window.dataLayer.push(arguments);
    };
    gtag("js", new Date());
    gtag("config", measurementId, { send_page_view: false });

    let lastPath = null;
    document.addEventListener("astro:page-load", () => {
      const path = location.pathname + location.search;
      if (path === lastPath) return; // avoid duplicates (e.g. hash changes)
      lastPath = path;
      gtag("event", "page_view", {
        page_location: location.href,
        page_path: path,
        page_title: document.title,
      });
    });
  }
</script>
