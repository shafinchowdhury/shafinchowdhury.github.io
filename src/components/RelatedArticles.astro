---
import type { CollectionEntry } from "astro:content";
import { getCollection } from "astro:content";
import { postFilter } from "@/utils/postFilter";
import { getPostUrl } from "@/utils/getPostPaths";
import { getReadingTime } from "@/utils/getReadingTime";
import { TOPIC_HUBS } from "@/data/topics";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import config from "@/config";

type Props = {
  currentPost: CollectionEntry<"posts">;
  maxPosts?: number;
};

const { currentPost, maxPosts = 3 } = Astro.props;
const locale = Astro.currentLocale ?? config.site.lang;

const allPosts = await getCollection("posts", postFilter);
const otherPosts = allPosts.filter(p => p.id !== currentPost.id);

const currentSlug = currentPost.id.replace(/\.(md|mdx)$/, "").toLowerCase();
const currentTags = new Set(
  (currentPost.data.tags ?? []).map(t => t.toLowerCase())
);

// Find topic hubs the current post belongs to
const currentTopics = Object.values(TOPIC_HUBS).filter(topic =>
  topic.groups.some(g => g.postSlugs.some(s => s.toLowerCase() === currentSlug))
);
const currentTopicSlugs = new Set(currentTopics.map(t => t.slug));

// Score each candidate post
const scoredPosts = otherPosts
  .map(post => {
    const postSlug = post.id.replace(/\.(md|mdx)$/, "").toLowerCase();
    const postTags = (post.data.tags ?? []).map(t => t.toLowerCase());

    let score = 0;

    // 1. Tag overlap (3 points per tag)
    for (const tag of postTags) {
      if (currentTags.has(tag)) {
        score += 3;
      }
    }

    // 2. Topic Hub overlap (5 points)
    const postInSameTopic = Object.values(TOPIC_HUBS).some(
      topic =>
        currentTopicSlugs.has(topic.slug) &&
        topic.groups.some(g =>
          g.postSlugs.some(s => s.toLowerCase() === postSlug)
        )
    );
    if (postInSameTopic) {
      score += 5;
    }

    // 3. Series matching (e.g. "Part 1", "Part 2", or "Python:")
    const curTitleLower = currentPost.data.title.toLowerCase();
    const postTitleLower = post.data.title.toLowerCase();

    if (
      (curTitleLower.includes("part ") && postTitleLower.includes("part ")) ||
      (curTitleLower.includes("python") && postTitleLower.includes("python")) ||
      (curTitleLower.includes("java") && postTitleLower.includes("java")) ||
      (curTitleLower.includes("memory") && postTitleLower.includes("memory"))
    ) {
      score += 8;
    }

    // 4. Slight recency weight for ties
    const ageBonus = new Date(post.data.pubDatetime).getTime() / 1000000000000;
    score += ageBonus;

    return { post, score };
  })
  .sort((a, b) => b.score - a.score);

const relatedPosts = scoredPosts.slice(0, maxPosts).map(item => item.post);
---

{
  relatedPosts.length > 0 && (
    <section class="not-prose border-border my-10 border-t border-dashed pt-8">
      <div class="mb-5 space-y-1">
        <h2 class="text-foreground text-xl font-bold tracking-tight sm:text-2xl">
          Related Articles
        </h2>
        <p class="text-muted-foreground text-xs sm:text-sm">
          Continue exploring related topics and foundational concepts.
        </p>
      </div>

      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {relatedPosts.map(post => {
          const readingTime = getReadingTime(post.body);
          const postUrl = getPostUrl(post.id, post.filePath, locale);

          return (
            <article class="border-border/80 group bg-muted/20 hover:border-accent hover:bg-muted/30 flex flex-col justify-between rounded-lg border p-4 transition-all">
              <div class="space-y-2">
                <div class="text-muted-foreground flex items-center justify-between text-xs">
                  <time datetime={post.data.pubDatetime.toISOString()}>
                    {post.data.pubDatetime.toLocaleDateString("en-US", {
                      month: "short",
                      day: "numeric",
                      year: "numeric",
                    })}
                  </time>
                  <span>{readingTime}</span>
                </div>

                <h3 class="text-foreground group-hover:text-accent text-sm leading-snug font-semibold sm:text-base">
                  <a href={postUrl} class="focus-outline hover:underline">
                    {post.data.title}
                  </a>
                </h3>

                <p class="text-muted-foreground line-clamp-2 text-xs leading-relaxed">
                  {post.data.description}
                </p>
              </div>

              <div class="border-border/40 mt-4 border-t pt-2">
                <a
                  href={postUrl}
                  class="text-accent inline-flex items-center gap-1 text-xs font-medium hover:underline"
                >
                  <span>Read Article</span>
                  <IconArrowRight class="size-3.5 transition-transform group-hover:translate-x-1 rtl:-rotate-180" />
                </a>
              </div>
            </article>
          );
        })}
      </div>
    </section>
  )
}
