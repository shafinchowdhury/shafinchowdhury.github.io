---
import type { CollectionEntry } from "astro:content";
import { getCollection } from "astro:content";
import { postFilter } from "@/utils/postFilter";
import { getPostUrl } from "@/utils/getPostPaths";
import { getReadingTime } from "@/utils/getReadingTime";
import { TOPIC_HUBS } from "@/data/topics";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import config from "@/config";

type Props = {
  currentPost: CollectionEntry<"posts">;
  maxPosts?: number;
};

const { currentPost, maxPosts = 3 } = Astro.props;
const locale = Astro.currentLocale ?? config.site.lang;

const allPosts = await getCollection("posts", postFilter);
const otherPosts = allPosts.filter(p => p.id !== currentPost.id);

const slugOf = (post: CollectionEntry<"posts">) =>
  post.id.replace(/\.(md|mdx)$/, "").toLowerCase();

const currentSlug = slugOf(currentPost);
const currentTags = new Set(
  (currentPost.data.tags ?? []).map(t => t.toLowerCase())
);

// Topic-hub groups are hand-curated series (e.g. "Custom Stack Implementations"),
// so sharing a group is a stronger signal than sharing a hub.
const groups = Object.values(TOPIC_HUBS).flatMap(topic =>
  topic.groups.map(g => ({
    hub: topic.slug,
    slugs: new Set(g.postSlugs.map(s => s.toLowerCase())),
  }))
);
const currentGroups = groups.filter(g => g.slugs.has(currentSlug));
const currentHubs = new Set(currentGroups.map(g => g.hub));

const scoredPosts = otherPosts
  .map(post => {
    const postSlug = slugOf(post);
    let score = 0;

    for (const tag of post.data.tags ?? [])
      if (currentTags.has(tag.toLowerCase())) score += 3;

    if (currentGroups.some(g => g.slugs.has(postSlug))) score += 8;
    else if (groups.some(g => currentHubs.has(g.hub) && g.slugs.has(postSlug)))
      score += 5;

    // Tiny recency weight to break ties.
    score += post.data.pubDatetime.getTime() / 1e13;

    return { post, score };
  })
  .sort((a, b) => b.score - a.score);

// Hand-picked `related` slugs from frontmatter come first, in their given order.
const picked = (currentPost.data.related ?? [])
  .map(slug => otherPosts.find(p => slugOf(p) === slug.toLowerCase()))
  .filter(p => p !== undefined);
const relatedPosts = [
  ...picked,
  ...scoredPosts.map(item => item.post).filter(p => !picked.includes(p)),
].slice(0, Math.max(maxPosts, picked.length));
---

{
  relatedPosts.length > 0 && (
    <section class="not-prose border-border my-10 border-t border-dashed pt-8">
      <div class="mb-5 space-y-1">
        <h2 class="text-foreground text-xl font-bold tracking-tight sm:text-2xl">
          Related Articles
        </h2>
        <p class="text-muted-foreground text-xs sm:text-sm">
          Continue exploring related topics and foundational concepts.
        </p>
      </div>

      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {relatedPosts.map(post => {
          const readingTime = getReadingTime(post.body);
          const postUrl = getPostUrl(post.id, post.filePath, locale);

          return (
            <article class="border-border/80 group bg-muted/20 hover:border-accent hover:bg-muted/30 relative flex cursor-pointer flex-col justify-between rounded-lg border p-4 transition-all">
              <div class="space-y-2">
                <div class="text-muted-foreground flex items-center justify-between text-xs">
                  <time datetime={post.data.pubDatetime.toISOString()}>
                    {post.data.pubDatetime.toLocaleDateString("en-US", {
                      month: "short",
                      day: "numeric",
                      year: "numeric",
                    })}
                  </time>
                  <span>{readingTime}</span>
                </div>

                <h3 class="text-foreground group-hover:text-accent text-sm leading-snug font-semibold sm:text-base">
                  <a href={postUrl} class="focus-outline hover:underline">
                    <span class="absolute inset-0" aria-hidden="true" />
                    {post.data.title}
                  </a>
                </h3>

                <p class="text-muted-foreground line-clamp-2 text-xs leading-relaxed">
                  {post.data.description}
                </p>
              </div>

              <div class="border-border/40 mt-4 border-t pt-2">
                <span class="text-accent inline-flex items-center gap-1 text-xs font-medium group-hover:underline">
                  <span>Read Article</span>
                  <IconArrowRight class="size-3.5 transition-transform group-hover:translate-x-1 rtl:-rotate-180" />
                </span>
              </div>
            </article>
          );
        })}
      </div>
    </section>
  )
}
