---
import Layout from "./Layout.astro";
import config from "@/config";
import { resolveDefaultOgImagePath } from "@/utils/resolveDefaultOgImagePath";
import {
  getPersonEntity,
  PERSON_ID,
  SITE_URL,
  WEBSITE_ID,
} from "@/utils/structuredData";

type Props = {
  title?: string;
  articleTitle?: string;
  description?: string;
  ogImage?: string;
  canonicalURL?: string;
  markdownURL?: string;
  pubDatetime?: Date;
  modDatetime?: Date | null;
  tags?: string[];
};

const { site } = config;

const {
  title,
  articleTitle,
  description,
  ogImage,
  canonicalURL,
  markdownURL,
  pubDatetime,
  modDatetime,
  tags = [],
} = Astro.props;

const resolvedCanonicalURL =
  canonicalURL ?? new URL(Astro.url.pathname, Astro.site ?? site.url).href;
const resolvedImageURL = new URL(
  ogImage ?? resolveDefaultOgImagePath(config),
  Astro.site ?? site.url
).href;
const headlineText = articleTitle ?? title ?? site.title;
const publishedISO = pubDatetime?.toISOString();
const modifiedISO = (modDatetime ?? pubDatetime)?.toISOString();

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    getPersonEntity(),
    {
      "@type": "BlogPosting",
      "@id": `${resolvedCanonicalURL}#article`,
      headline: headlineText,
      description: description ?? site.description,
      image: [resolvedImageURL],
      inLanguage: site.lang ?? "en",
      isPartOf: { "@id": WEBSITE_ID },
      mainEntityOfPage: {
        "@type": "WebPage",
        "@id": resolvedCanonicalURL,
      },
      ...(publishedISO && { datePublished: publishedISO }),
      ...(modifiedISO && { dateModified: modifiedISO }),
      ...(tags.length > 0 && { keywords: tags.join(", ") }),
      author: { "@id": PERSON_ID },
      publisher: { "@id": PERSON_ID },
    },
    {
      "@type": "BreadcrumbList",
      "@id": `${resolvedCanonicalURL}#breadcrumb`,
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: `${SITE_URL}/`,
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Posts",
          item: `${SITE_URL}/posts/`,
        },
        {
          "@type": "ListItem",
          position: 3,
          name: headlineText,
          item: resolvedCanonicalURL,
        },
      ],
    },
  ],
};
---

<Layout
  {title}
  {description}
  {ogImage}
  canonicalURL={resolvedCanonicalURL}
  {markdownURL}
>
  <Fragment slot="head">
    <!-- Override og:type for article pages -->
    <meta property="og:type" content="article" />

    {
      publishedISO && (
        <meta property="article:published_time" content={publishedISO} />
      )
    }
    {
      modifiedISO && (
        <meta property="article:modified_time" content={modifiedISO} />
      )
    }

    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(structuredData)}
    />
  </Fragment>

  <slot />
</Layout>
