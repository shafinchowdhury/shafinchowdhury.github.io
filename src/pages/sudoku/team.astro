---
import Shell from "@/sudoku/Shell.astro";
import Board from "@/sudoku/Board.astro";

const hearts = Array.from({ length: 3 }, () => "♥");
---

<Shell title="Team Sudoku · Sudoku Together" noindex>
  <main id="game" class="game">
    <div>
      <p class="banner">
        You're out of lives. Keep watching. Your team can still finish.
      </p>
      <div class="stats">
        <span id="diff-label">…</span>
        <span
          >Lives <span class="hearts" id="my-hearts" aria-label="3 lives left"
            >{hearts.map(h => <i class="full">{h}</i>)}</span
          ></span
        >
        <span>Time <b id="timer">00:00</b></span>
      </div>
      <Board controls={["erase", "notes", "hint"]} />
    </div>

    <aside class="side">
      <div class="card">
        <p class="section-title">Room code</p>
        <div class="code">
          <span id="room-code"></span>
          <button class="btn btn-ghost" id="copy">Copy invite</button>
        </div>
        <p class="muted" id="conn" role="status">Connecting…</p>
      </div>
      <div class="card">
        <p class="section-title">Progress</p>
        <div class="progress">
          <i id="progress-bar" style="width:0"></i>
        </div>
        <p class="muted" id="progress-text">0 / 0 cells solved</p>
      </div>
      <div class="card">
        <p class="section-title">Team</p>
        <div id="players"></div>
      </div>
      <div class="card row">
        <button class="btn btn-ghost" id="reset">Reset Game</button>
        <button class="btn btn-ghost" id="new-game">New Game</button>
      </div>
    </aside>
  </main>

  <Fragment slot="after">
    <dialog id="name-dialog">
      <h2>Join this team</h2>
      <p>Pick a name so your teammates know who's who.</p>
      <form id="name-form">
        <label class="field"
          >Your name
          <input
            name="name"
            required
            maxlength="20"
            autocomplete="nickname"
          /></label
        >
        <div class="row">
          <a class="btn btn-ghost" href="/sudoku">Cancel</a>
          <button class="btn btn-primary">Join</button>
        </div>
      </form>
    </dialog>

    <dialog id="new-dialog">
      <h2>Start a new puzzle?</h2>
      <p>The whole team gets a new board and full lives.</p>
      <div class="seg" role="group" aria-label="Difficulty" id="new-diff">
        <button data-d="easy" aria-pressed="true">Easy</button>
        <button data-d="medium" aria-pressed="false">Medium</button>
        <button data-d="hard" aria-pressed="false">Hard</button>
      </div>
      <form method="dialog" class="row">
        <button class="btn btn-ghost" value="cancel">Cancel</button>
        <button class="btn btn-primary" value="ok">New Game</button>
      </form>
    </dialog>

    <dialog id="reset-dialog">
      <h2>Reset this puzzle for everyone?</h2>
      <p>The board, timer and everyone's lives start over.</p>
      <form method="dialog" class="row">
        <button class="btn btn-ghost" value="cancel">Cancel</button>
        <button class="btn btn-primary" value="ok">Reset</button>
      </form>
    </dialog>

    <dialog id="done-dialog">
      <h2 id="done-title">Solved!</h2>
      <p id="done-text"></p>
      <form method="dialog" class="row">
        <button class="btn btn-ghost" value="close">Close</button>
        <button class="btn btn-ghost" value="retry" id="done-retry"
          >Try again</button
        >
        <button class="btn btn-primary" value="new">New Game</button>
      </form>
    </dialog>

    <dialog id="error-dialog">
      <h2>Can't join this room</h2>
      <p id="error-text"></p>
      <div class="row">
        <a class="btn btn-primary" href="/sudoku">Back to home</a>
      </div>
    </dialog>

    <script>
      import "@/sudoku/team";
    </script>
  </Fragment>
</Shell>
