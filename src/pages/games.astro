---
import { getRelativeLocaleUrl } from "astro:i18n";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import { useTranslations } from "@/i18n";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

// Add new games here; each one becomes a card on this page (logo goes in public/assets/games/).
const games = [
  {
    title: "Sudoku Together",
    path: "sudoku",
    logo: "/assets/games/sudoku.svg",
    description:
      "Three lives, two hints, one grid that punishes guessing. Play solo, or share a room link and solve it live with friends.",
  },
];
---

<Layout
  title={`${t.pages.gamesTitle} | ${config.site.title}`}
  description={t.pages.gamesDesc}
>
  <Header />

  <Breadcrumb />

  <Main pageTitle={t.pages.gamesTitle} pageDesc={t.pages.gamesDesc}>
    <div class="grid gap-6 sm:grid-cols-2 lg:gap-8">
      {
        games.map(game => (
          <article class="border-border/80 group bg-muted/20 hover:border-accent hover:bg-muted/30 relative flex flex-col justify-between rounded-xl border p-6 transition-all duration-300 hover:shadow-sm">
            <div class="space-y-3">
              <div class="flex items-center gap-4">
                <img
                  src={game.logo}
                  alt=""
                  width="56"
                  height="56"
                  class="size-14 shrink-0 rounded-xl"
                />
                <h2 class="text-foreground group-hover:text-accent text-2xl font-bold tracking-tight transition-colors sm:text-3xl">
                  <a
                    href={getRelativeLocaleUrl(locale, game.path)}
                    class="focus-outline"
                  >
                    <span class="absolute inset-0" aria-hidden="true" />
                    {game.title}
                  </a>
                </h2>
              </div>
              <p class="text-muted-foreground text-sm leading-relaxed sm:text-base">
                {game.description}
              </p>
            </div>
            <div class="text-accent mt-6 flex items-center gap-1.5 text-sm font-medium">
              <span>Play {game.title}</span>
              <IconArrowRight class="size-4 transition-transform group-hover:translate-x-1 rtl:-rotate-180" />
            </div>
          </article>
        ))
      }
    </div>
  </Main>

  <Footer />
</Layout>
