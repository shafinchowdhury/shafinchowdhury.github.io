---
export type Heading = {
  depth: number;
  slug: string;
  text: string;
};

type Props = {
  headings: Heading[];
};

const { headings } = Astro.props;

// Filter out "Table of Contents" itself and keep depth 2 and depth 3
const tocHeadings = headings.filter(
  h => h.slug !== "table-of-contents" && (h.depth === 2 || h.depth === 3)
);

const hasSubheadings = tocHeadings.some(h => h.depth === 3);
const sectionCount = hasSubheadings
  ? tocHeadings.filter(h => h.depth === 3).length
  : tocHeadings.length;
---

{
  tocHeadings.length > 0 && (
    <>
      <!-- ============================================== -->
      <!-- 1. Mobile Inline Collapsible Card (Top of Post)-->
      <!-- ============================================== -->
      <details
        id="mobile-toc-accordion"
        class="mobile-toc group lg:hidden w-full mb-8 rounded-xl border border-border/80 bg-muted/20 backdrop-blur-xs p-3.5 transition-colors"
      >
        <summary class="flex cursor-pointer items-center justify-between font-semibold text-[13.5px] text-foreground select-none list-none">
          <span class="flex items-center gap-2">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="size-4 text-accent"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <line x1="8" y1="6" x2="21" y2="6" />
              <line x1="8" y1="12" x2="21" y2="12" />
              <line x1="8" y1="18" x2="21" y2="18" />
              <line x1="3" y1="6" x2="3.01" y2="6" />
              <line x1="3" y1="12" x2="3.01" y2="12" />
              <line x1="3" y1="18" x2="3.01" y2="18" />
            </svg>
            <span>Table of Contents</span>
          </span>
          <span class="flex items-center gap-2 text-xs text-muted-foreground font-normal">
            <span class="font-mono bg-muted/70 px-2 py-0.5 rounded text-[11px] font-medium text-foreground/80">
              {sectionCount} topics
            </span>
            <svg
              class="chevron-arrow size-4 transition-transform duration-200 group-open:rotate-180"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <polyline points="6 9 12 15 18 9" />
            </svg>
          </span>
        </summary>

        <nav class="mt-3.5 pt-3 border-t border-border/40 max-h-[55vh] overflow-y-auto space-y-0.5 pr-1 scrollbar-thin">
          {tocHeadings.map(h =>
            h.depth === 2 ? (
              <div class:list={["pt-3 pb-0.5 first:pt-0", hasSubheadings && "border-t border-border/25 first:border-0"]}>
                <a
                  href={`#${h.slug}`}
                  class="mobile-toc-link block font-bold text-[12px] uppercase tracking-wider text-accent hover:text-accent/80 transition-colors py-1 px-1.5"
                >
                  {h.text}
                </a>
              </div>
            ) : (
              <a
                href={`#${h.slug}`}
                class="mobile-toc-link block py-1 pl-3 text-[12.5px] text-muted-foreground hover:text-accent transition-colors leading-snug rounded hover:bg-muted/40 px-1.5"
              >
                <span class="line-clamp-1">{h.text}</span>
              </a>
            )
          )}
        </nav>
      </details>

      <!-- ============================================== -->
      <!-- 2. Mobile Floating Quick-Jump Pill & Drawer    -->
      <!-- ============================================== -->
      <div
        id="mobile-toc-fab-container"
        class="lg:hidden fixed start-4 bottom-8 z-40 translate-y-16 opacity-0 transition-all duration-300"
      >
        <button
          id="mobile-toc-open-btn"
          type="button"
          class="flex items-center gap-1.5 rounded-full border border-border/80 bg-background/90 px-3.5 py-2 text-xs font-semibold text-foreground shadow-lg backdrop-blur-md transition-transform active:scale-95 hover:bg-muted"
          aria-label="Open Table of Contents"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="size-3.5 text-accent"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <line x1="8" y1="6" x2="21" y2="6" />
            <line x1="8" y1="12" x2="21" y2="12" />
            <line x1="8" y1="18" x2="21" y2="18" />
            <line x1="3" y1="6" x2="3.01" y2="6" />
            <line x1="3" y1="12" x2="3.01" y2="12" />
            <line x1="3" y1="18" x2="3.01" y2="18" />
          </svg>
          <span>Contents</span>
          <span class="text-[10px] font-mono text-muted-foreground bg-muted px-1.5 py-0.5 rounded-full font-medium">
            {sectionCount}
          </span>
        </button>
      </div>

      <!-- Mobile Bottom Sheet Drawer -->
      <div
        id="mobile-toc-drawer"
        class="lg:hidden fixed inset-0 z-50 pointer-events-none opacity-0 transition-opacity duration-300"
        aria-hidden="true"
      >
        <div id="mobile-toc-backdrop" class="absolute inset-0 bg-black/50 backdrop-blur-xs" />

        <div
          id="mobile-toc-sheet"
          class="absolute inset-x-0 bottom-0 max-h-[75vh] flex flex-col rounded-t-2xl border-t border-border bg-background p-4 shadow-2xl transition-transform duration-300 translate-y-full"
        >
          <div class="flex items-center justify-between pb-3 border-b border-border/50">
            <div class="flex items-center gap-2">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="size-4 text-accent"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <line x1="8" y1="6" x2="21" y2="6" />
                <line x1="8" y1="12" x2="21" y2="12" />
                <line x1="8" y1="18" x2="21" y2="18" />
                <line x1="3" y1="6" x2="3.01" y2="6" />
                <line x1="3" y1="12" x2="3.01" y2="12" />
                <line x1="3" y1="18" x2="3.01" y2="18" />
              </svg>
              <span class="font-bold text-sm">Table of Contents</span>
              <span class="text-xs text-muted-foreground font-mono">({sectionCount})</span>
            </div>
            <button
              id="mobile-toc-close-btn"
              type="button"
              class="p-1 rounded-md text-muted-foreground hover:text-foreground hover:bg-muted"
              aria-label="Close Table of Contents"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="size-5"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <line x1="18" y1="6" x2="6" y2="18" />
                <line x1="6" y1="6" x2="18" y2="18" />
              </svg>
            </button>
          </div>

          <nav class="mt-2 overflow-y-auto space-y-0.5 py-2 scrollbar-thin flex-1">
            {tocHeadings.map(h =>
              h.depth === 2 ? (
                <div class:list={["pt-3 pb-0.5 first:pt-0", hasSubheadings && "border-t border-border/25 first:border-0"]}>
                  <a
                    href={`#${h.slug}`}
                    class="drawer-toc-link block font-bold text-[12px] uppercase tracking-wider text-accent hover:text-accent/80 transition-colors py-1 px-1.5"
                  >
                    {h.text}
                  </a>
                </div>
              ) : (
                <a
                  href={`#${h.slug}`}
                  class="drawer-toc-link block py-1.5 pl-3 text-[13px] text-muted-foreground hover:text-accent transition-colors leading-snug rounded hover:bg-muted/40 px-1.5"
                >
                  <span class="line-clamp-1">{h.text}</span>
                </a>
              )
            )}
          </nav>
        </div>
      </div>

      <!-- ============================================== -->
      <!-- 3. Desktop Sticky Right Sidebar                -->
      <!-- ============================================== -->
      <aside
        id="toc-sidebar"
        class="hidden lg:block w-64 xl:w-72 shrink-0 sticky top-24 max-h-[calc(100vh-7rem)] overflow-y-auto pl-5 border-l border-border/50 text-[13px] scrollbar-thin lg:order-last"
        aria-label="Table of Contents"
      >
        <div class="flex items-center justify-between mb-3 pb-2 border-b border-border/40">
          <span class="font-semibold uppercase tracking-wider text-xs text-foreground/80 flex items-center gap-1.5">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="size-3.5 text-accent"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <line x1="8" y1="6" x2="21" y2="6" />
              <line x1="8" y1="12" x2="21" y2="12" />
              <line x1="8" y1="18" x2="21" y2="18" />
              <line x1="3" y1="6" x2="3.01" y2="6" />
              <line x1="3" y1="12" x2="3.01" y2="12" />
              <line x1="3" y1="18" x2="3.01" y2="18" />
            </svg>
            Table of Contents
          </span>
          <span class="text-[11px] text-muted-foreground font-mono">
            {sectionCount}
          </span>
        </div>

        <nav class="space-y-0.5">
          {tocHeadings.map(h =>
            h.depth === 2 ? (
              <div class:list={["pt-3 pb-0.5 first:pt-0", hasSubheadings && "border-t border-border/25 first:border-0"]}>
                <a
                  href={`#${h.slug}`}
                  data-toc-link={h.slug}
                  class="toc-link block font-bold text-[11.5px] uppercase tracking-wider text-accent/90 hover:text-accent transition-colors py-0.5 rounded px-1.5 -mx-1.5"
                >
                  <span class="line-clamp-1">{h.text}</span>
                </a>
              </div>
            ) : (
              <a
                href={`#${h.slug}`}
                data-toc-link={h.slug}
                class="toc-link block py-0.5 pl-3 text-[12px] text-muted-foreground hover:text-accent transition-colors leading-snug rounded hover:bg-muted/30 px-1.5 -mx-1.5"
              >
                <span class="line-clamp-1">{h.text}</span>
              </a>
            )
          )}
        </nav>
      </aside>
    </>
  )
}

<script is:inline data-astro-rerun>
  function setupTableOfContents() {
    // 1. Desktop active link observer
    const desktopLinks = document.querySelectorAll(".toc-link");
    if (desktopLinks.length) {
      const headingElements = [];
      desktopLinks.forEach(link => {
        const slug = link.getAttribute("data-toc-link");
        const el = document.getElementById(slug);
        if (el) headingElements.push({ el, link });
      });

      if (headingElements.length) {
        let activeLink = null;
        const observer = new IntersectionObserver(
          entries => {
            const visible = entries.filter(e => e.isIntersecting);
            if (visible.length > 0) {
              const topVisible = visible.reduce((prev, curr) =>
                prev.boundingClientRect.top < curr.boundingClientRect.top ? prev : curr
              );
              const found = headingElements.find(h => h.el === topVisible.target);
              if (found) {
                if (activeLink) activeLink.classList.remove("text-accent", "font-semibold", "bg-accent/10");
                activeLink = found.link;
                activeLink.classList.add("text-accent", "font-semibold", "bg-accent/10");
                const sidebar = document.getElementById("toc-sidebar");
                if (sidebar) {
                  const rect = activeLink.getBoundingClientRect();
                  const sideRect = sidebar.getBoundingClientRect();
                  if (rect.top < sideRect.top || rect.bottom > sideRect.bottom) {
                    activeLink.scrollIntoView({ block: "nearest", behavior: "smooth" });
                  }
                }
              }
            }
          },
          { rootMargin: "-80px 0px -70% 0px", threshold: 0 }
        );
        headingElements.forEach(h => observer.observe(h.el));
      }
    }

    // 2. Mobile accordion auto-close on link click
    const mobileLinks = document.querySelectorAll(".mobile-toc-link");
    const mobileAccordion = document.getElementById("mobile-toc-accordion");
    mobileLinks.forEach(link => {
      link.addEventListener("click", () => {
        if (mobileAccordion && mobileAccordion.open) {
          mobileAccordion.removeAttribute("open");
        }
      });
    });

    // 3. Mobile Floating pill and bottom drawer
    const fabContainer = document.getElementById("mobile-toc-fab-container");
    const openBtn = document.getElementById("mobile-toc-open-btn");
    const closeBtn = document.getElementById("mobile-toc-close-btn");
    const drawer = document.getElementById("mobile-toc-drawer");
    const backdrop = document.getElementById("mobile-toc-backdrop");
    const sheet = document.getElementById("mobile-toc-sheet");
    const drawerLinks = document.querySelectorAll(".drawer-toc-link");

    if (fabContainer && openBtn && drawer && sheet) {
      function openDrawer() {
        drawer.classList.remove("pointer-events-none", "opacity-0");
        drawer.classList.add("pointer-events-auto", "opacity-100");
        sheet.classList.remove("translate-y-full");
        sheet.classList.add("translate-y-0");
        document.body.style.overflow = "hidden";
      }

      function closeDrawer() {
        drawer.classList.add("opacity-0", "pointer-events-none");
        drawer.classList.remove("opacity-100", "pointer-events-auto");
        sheet.classList.add("translate-y-full");
        sheet.classList.remove("translate-y-0");
        document.body.style.overflow = "";
      }

      openBtn.addEventListener("click", openDrawer);
      if (closeBtn) closeBtn.addEventListener("click", closeDrawer);
      if (backdrop) backdrop.addEventListener("click", closeDrawer);

      drawerLinks.forEach(link => {
        link.addEventListener("click", closeDrawer);
      });

      window.addEventListener("keydown", e => {
        if (e.key === "Escape") closeDrawer();
      });

      // Show/hide floating button on scroll
      window.addEventListener(
        "scroll",
        () => {
          const scrollTop = window.scrollY || document.documentElement.scrollTop;
          const showFab = scrollTop > 350;
          fabContainer.classList.toggle("translate-y-0", showFab);
          fabContainer.classList.toggle("opacity-100", showFab);
          fabContainer.classList.toggle("translate-y-16", !showFab);
          fabContainer.classList.toggle("opacity-0", !showFab);
        },
        { passive: true }
      );
    }
  }

  setupTableOfContents();
  document.addEventListener("astro:after-swap", setupTableOfContents);
</script>
