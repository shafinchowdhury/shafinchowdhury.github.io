---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Footer from "@/components/Footer.astro";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import { TOPIC_HUBS, type TopicHub } from "@/data/topics";
import { postFilter } from "@/utils/postFilter";
import { getPostUrl } from "@/utils/getPostPaths";
import { getReadingTime } from "@/utils/getReadingTime";
import config from "@/config";

export async function getStaticPaths() {
  return Object.keys(TOPIC_HUBS).map(topic => ({
    params: { topic },
  }));
}

const { topic: topicSlug } = Astro.params;
const topicData: TopicHub | undefined = TOPIC_HUBS[topicSlug as string];

if (!topicData) {
  return Astro.redirect("/404");
}

const locale = Astro.currentLocale ?? config.site.lang;
const posts = await getCollection("posts", postFilter);

// Helper to look up a post by slug
function findPostBySlug(slug: string) {
  return posts.find(p => {
    const postSlug = p.id.replace(/\.(md|mdx)$/, "");
    return postSlug.toLowerCase() === slug.toLowerCase();
  });
}

// Resolve related topics
const relatedTopics = topicData.relatedTopicSlugs
  .map(slug => TOPIC_HUBS[slug])
  .filter(Boolean);

const pageTitle = `${topicData.title} | ${config.site.title}`;
const pageDescription = topicData.description;
const canonicalURL = new URL(Astro.url.pathname, Astro.site).href;

const schemaData = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: topicData.title,
  description: topicData.description,
  url: canonicalURL,
  publisher: {
    "@type": "Person",
    name: config.site.author,
    url: config.site.url,
  },
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonicalURL={canonicalURL}
>
  <Fragment slot="head">
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(schemaData)}
    />
  </Fragment>

  <Header />

  <Breadcrumb />

  <main id="main-content" class="app-layout py-8 sm:py-12">
    <!-- Topic Intro Header -->
    <header class="mb-12 max-w-3xl space-y-4">
      <div class="inline-flex items-center gap-2">
        <a
          href={getRelativeLocaleUrl(locale, "topics")}
          class="text-accent text-xs font-semibold tracking-wider uppercase hover:underline"
        >
          Topic Hub
        </a>
        <span class="text-muted-foreground text-xs" aria-hidden="true"
          >&raquo;</span
        >
        <span
          class="bg-accent/10 text-accent rounded-md px-2.5 py-0.5 text-xs font-semibold"
        >
          {topicData.name}
        </span>
      </div>

      <h1
        class="text-foreground text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl"
      >
        {topicData.title}
      </h1>

      <p class="text-muted-foreground text-base leading-relaxed sm:text-lg">
        {topicData.intro}
      </p>
    </header>

    <!-- Structured Learning Path -->
    <section class="mb-14">
      <div class="border-border mb-6 space-y-1 border-b pb-3">
        <h2 class="text-foreground text-2xl font-bold tracking-tight">
          Curated Learning Path
        </h2>
        <p class="text-muted-foreground text-sm">
          Follow this progressive roadmap from foundational mechanics to
          advanced implementations.
        </p>
      </div>

      <div
        class="before:bg-border/60 relative space-y-4 before:absolute before:inset-0 before:left-3.5 before:w-0.5"
      >
        {
          topicData.learningPath.map(step => {
            const stepPost = findPostBySlug(step.postSlug);
            const postHref = stepPost
              ? getPostUrl(stepPost.id, stepPost.filePath, locale)
              : null;
            const stepReadingTime = stepPost
              ? getReadingTime(stepPost.body)
              : null;

            return (
              <div class="relative flex items-start gap-4 ps-1 sm:ps-2">
                <div class="bg-background border-accent text-accent flex size-7 shrink-0 items-center justify-center rounded-full border-2 text-xs font-bold shadow-xs">
                  {step.step}
                </div>

                <div class="border-border/80 bg-muted/20 hover:border-accent hover:bg-muted/30 flex-1 rounded-lg border p-4 transition-colors">
                  <div class="flex flex-wrap items-center justify-between gap-2">
                    <span
                      class:list={[
                        "rounded px-2 py-0.5 text-xs font-semibold",
                        step.level === "Beginner"
                          ? "bg-emerald-500/10 text-emerald-600 dark:text-emerald-400"
                          : step.level === "Intermediate"
                            ? "bg-amber-500/10 text-amber-600 dark:text-amber-400"
                            : "bg-purple-500/10 text-purple-600 dark:text-purple-400",
                      ]}
                    >
                      {step.level}
                    </span>

                    {stepReadingTime && (
                      <span class="text-muted-foreground text-xs">
                        {stepReadingTime}
                      </span>
                    )}
                  </div>

                  <h3 class="text-foreground mt-2 text-base font-semibold sm:text-lg">
                    {postHref ? (
                      <a
                        href={postHref}
                        class="hover:text-accent focus-outline hover:underline"
                      >
                        {step.title}
                      </a>
                    ) : (
                      step.title
                    )}
                  </h3>

                  <p class="text-muted-foreground mt-1 text-sm leading-relaxed">
                    {step.description}
                  </p>

                  {postHref && (
                    <div class="mt-3">
                      <a
                        href={postHref}
                        class="text-accent inline-flex items-center gap-1 text-xs font-medium hover:underline"
                      >
                        <span>Start Step {step.step}</span>
                        <IconArrowRight class="size-3.5 rtl:-rotate-180" />
                      </a>
                    </div>
                  )}
                </div>
              </div>
            );
          })
        }
      </div>
    </section>

    <!-- Article Groups -->
    <section class="mb-14">
      <div class="border-border mb-6 space-y-1 border-b pb-3">
        <h2 class="text-foreground text-2xl font-bold tracking-tight">
          Articles by Category
        </h2>
        <p class="text-muted-foreground text-sm">
          Browse all technical guides and references organized by subject area.
        </p>
      </div>

      <div class="space-y-8">
        {
          topicData.groups.map(group => {
            const groupPosts = group.postSlugs
              .map(slug => findPostBySlug(slug))
              .filter(Boolean);

            if (groupPosts.length === 0) return null;

            return (
              <div class="space-y-3">
                <div class="space-y-0.5">
                  <h3 class="text-foreground text-lg font-bold">
                    {group.name}
                  </h3>
                  <p class="text-muted-foreground text-xs">
                    {group.description}
                  </p>
                </div>

                <div class="grid gap-3 sm:grid-cols-2">
                  {groupPosts.map(post => {
                    if (!post) return null;
                    const readingTime = getReadingTime(post.body);
                    return (
                      <article class="border-border/80 group bg-muted/20 hover:border-accent hover:bg-muted/30 rounded-lg border p-4 transition-colors">
                        <h4 class="text-foreground group-hover:text-accent text-sm leading-snug font-semibold sm:text-base">
                          <a
                            href={getPostUrl(post.id, post.filePath, locale)}
                            class="focus-outline hover:underline"
                          >
                            {post.data.title}
                          </a>
                        </h4>
                        <p class="text-muted-foreground mt-1.5 line-clamp-2 text-xs leading-relaxed">
                          {post.data.description}
                        </p>
                        <div class="text-muted-foreground mt-3 flex items-center justify-between text-xs">
                          <time datetime={post.data.pubDatetime.toISOString()}>
                            {post.data.pubDatetime.toLocaleDateString("en-US", {
                              month: "short",
                              day: "numeric",
                              year: "numeric",
                            })}
                          </time>
                          <span>{readingTime}</span>
                        </div>
                      </article>
                    );
                  })}
                </div>
              </div>
            );
          })
        }
      </div>
    </section>

    <!-- Related Topics / Pillars -->
    {
      relatedTopics.length > 0 && (
        <section class="border-border/80 bg-muted/20 rounded-xl border p-6 sm:p-8">
          <div class="mb-4 space-y-1">
            <h2 class="text-foreground text-xl font-bold tracking-tight">
              Related Topic Hubs
            </h2>
            <p class="text-muted-foreground text-xs sm:text-sm">
              Broaden your knowledge across interconnected computer science
              domains.
            </p>
          </div>

          <div class="grid gap-4 sm:grid-cols-2">
            {relatedTopics.map(related => (
              <a
                href={getRelativeLocaleUrl(locale, `topics/${related.slug}`)}
                class="border-border/80 group bg-background/80 hover:border-accent hover:bg-background rounded-lg border p-4 transition-all"
              >
                <div class="flex items-center justify-between">
                  <span class="bg-accent/10 text-accent rounded px-2 py-0.5 text-xs font-semibold">
                    {related.name}
                  </span>
                  <IconArrowRight class="text-accent size-4 transition-transform group-hover:translate-x-1 rtl:-rotate-180" />
                </div>
                <h3 class="text-foreground group-hover:text-accent mt-2 text-sm font-semibold">
                  {related.title}
                </h3>
                <p class="text-muted-foreground mt-1 line-clamp-2 text-xs">
                  {related.description}
                </p>
              </a>
            ))}
          </div>
        </section>
      )
    }
  </main>

  <Footer />
</Layout>
